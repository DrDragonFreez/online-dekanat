# ─── OCR ───
# Windows:
# DEKANAT_TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe
# DEKANAT_TESSDATA_PREFIX=C:\Program Files\Tesseract-OCR\tessdata
# Linux / Docker: оставь пусто — найдёт /usr/bin/tesseract сам
DEKANAT_TESSERACT_PATH=
DEKANAT_TESSDATA_PREFIX=
DEKANAT_TESSERACT_LANG=rus
DEKANAT_OCR_PSM=6

# ─── App ───
DEKANAT_DEBUG=false
DEKANAT_MAX_UPLOAD_MB=20

# ─── LLM (если используется) ───
DEKANAT_OPENAI_API_KEY=
DEKANAT_LLM_MODEL=gpt-4o-mini